{
  "name": "geotopology",
  "version": "1.0.0",
  "description": "Enterprise-grade 3D Nationwide Telecom Network Topology & NOC Integrated Monitoring Viewer for React",
  "type": "module",
  "main": "./dist/geotopology.cjs.js",
  "module": "./dist/geotopology.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/geotopology.es.js",
      "require": "./dist/geotopology.cjs.js",
      "types": "./dist/types/index.d.ts"
    },
    "./style.css": "./dist/geotopology.css",
    "./dist/style.css": "./dist/geotopology.css"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "dev": "vite",
    "build:app": "tsc -b && vite build",
    "build:lib": "vite build --config vite.config.lib.ts && tsc -p tsconfig.lib.json",
    "build": "npm run build:app && npm run build:lib",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@deck.gl/geo-layers": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mapbox": "^9.4.0",
    "@deck.gl/react": "^9.4.0",
    "clsx": "^2.1.1",
    "deck.gl": "^9.4.0",
    "lucide-react": "^1.46.0",
    "maplibre-gl": "^6.10.0",
    "pmtiles": "^4.5.0",
    "protomaps-themes-base": "^4.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
